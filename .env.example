# Supabase project URL (client-exposed) — Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (client-exposed) — Project Settings > API > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key (server-only, NEVER expose to the client) — Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gemini API key (server-only) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Google Places API (New) key (server-only) — Google Cloud Console > APIs & Services > Credentials
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Server-only switch read by lib/current-user.ts: set to the literal string "false" to disable falling back to the seeded demo user when there's no session (default: demo fallback allowed, per PRD §0)
DEMO_MODE=
